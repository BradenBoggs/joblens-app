{
  "expo": {
    "name": "JobLens",
    "slug": "joblens-app",
    "version": "0.1.0",
    "scheme": "joblens",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "bundleIdentifier": "io.joblens.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "JobLens uses the camera to take project photos. Photos are saved on this phone and upload to the project when you have service."
      }
    },
    "android": {
      "package": "io.joblens.app",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/icon.png",
          "imageWidth": 88
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JobLens records where each project photo was taken, even without service.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
